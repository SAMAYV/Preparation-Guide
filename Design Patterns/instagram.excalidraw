  "elements": [
    {
      "id": "J1UDdATtTnmpszDsz5QbG",
      "type": "text",
      "x": -117.23139000243194,
      "y": 241.1668346774203,
      "width": 599.7915649414062,
      "height": 145.3247655909289,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "an",
      "roundness": null,
      "seed": 1679352489,
      "version": 499,
      "versionNonce": 1603303721,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1777873908347,
      "link": null,
      "locked": false,
      "text": "Functional Requirements\n1. Users should be able to upload/download/view photos.\n2. Users can perform searches based on photo/video titles.\n3. Users can follow other users.\n4. The system should generate and display a user’s News Feed \nconsisting of top photos from all the people the user follows.",
      "fontSize": 19.376635412123854,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements\n1. Users should be able to upload/download/view photos.\n2. Users can perform searches based on photo/video titles.\n3. Users can follow other users.\n4. The system should generate and display a user’s News Feed \nconsisting of top photos from all the people the user follows.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "0WiqybsNZQxmXHEPjLKZ2",
      "type": "text",
      "x": -156.47749984730436,
      "y": 656.9656823932949,
      "width": 750.1027221679688,
      "height": 217.98714838639333,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "as",
      "roundness": null,
      "seed": 1016531623,
      "version": 473,
      "versionNonce": 179310247,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1777873905589,
      "link": null,
      "locked": false,
      "text": "Non-functional Requirements\n1. Our service needs to be highly available.\n2. The acceptable latency of the system is 200ms for News Feed generation.\n3. Consistency can take a hit (in the interest of availability) if a user \ndoesn’t see a photo for a while; it should be fine.\n4. The system should be highly reliable; any uploaded photo or video should \nnever be lost.\n5. Not in scope: Adding tags to photos, searching photos on tags, commenting \non photos, tagging users to photos, who to follow, etc.",
      "fontSize": 19.376635412123854,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-functional Requirements\n1. Our service needs to be highly available.\n2. The acceptable latency of the system is 200ms for News Feed generation.\n3. Consistency can take a hit (in the interest of availability) if a user \ndoesn’t see a photo for a while; it should be fine.\n4. The system should be highly reliable; any uploaded photo or video should \nnever be lost.\n5. Not in scope: Adding tags to photos, searching photos on tags, commenting \non photos, tagging users to photos, who to follow, etc.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "FmBwEAXLIHgg8qOU5kiBv",
      "type": "text",
      "x": 68.2216481854839,
      "y": -99.12424395161219,
      "width": 134.5799102783203,
      "height": 100,
      "angle": 0,
